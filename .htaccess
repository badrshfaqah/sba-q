# منصة متابعة جودة البث والمحتوى الإذاعي
# ملف إعدادات Apache — كل التوجيهات محمية بـ IfModule لتفادي خطأ 500 على أي استضافة
# إن ظهر خطأ 500 بعد الرفع: احذف هذا الملف — المنصة تعمل بدونه تماماً

# حماية الملفات الحساسة من التحميل المباشر
<FilesMatch "^(config\.php|VERSION|\.gitignore|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        <IfModule mod_access_compat.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </IfModule>
</FilesMatch>

# ملفات النسخ الاحتياطي والسجلات لا تُحمّل مباشرة
<FilesMatch "\.(sql|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        <IfModule mod_access_compat.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </IfModule>
</FilesMatch>

# ترويسات حماية (تُرسل أيضاً من PHP — هذه طبقة إضافية)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
</IfModule>

# ضغط المخرجات لتسريع التصفح
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# تخزين مؤقت للأصول الثابتة
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
